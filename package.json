{
  "name": "algoflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "admin:bootstrap": "tsx server/scripts/bootstrapAdmin.ts",
    "env:secrets": "tsx server/scripts/generateLocalSecrets.ts",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "verify:artifact": "tsx scripts/verifyDeployArtifact.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:server": "tsx scripts/typecheckServer.ts",
    "e2e": "playwright test --project=chromium",
    "e2e:headed": "playwright test --project=chromium --headed",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium firefox webkit",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build && npm run e2e",
    "e2e:cross": "playwright test --project=firefox --project=webkit --project=mobile-chromium --project=mobile-webkit",
    "e2e:all": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.52.0",
    "mongoose": "^9.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
