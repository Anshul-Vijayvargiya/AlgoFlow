# Server Configuration
PORT=5000
# Optional. Defaults to 127.0.0.1 in development (this machine only) and 0.0.0.0 in staging/production.
# Set HOST=0.0.0.0 in development only if another device must reach this server.
# HOST=
# Required. development | test | staging | production. staging and production are "strict": real secrets
# (>= 32 chars, not these placeholders), https CLIENT_URL, explicit MONGODB_URI, Secure cookies, masked errors,
# no seeding, and startup is refused while development seed accounts exist in the database.
NODE_ENV=development
# In staging/production: the front end's exact https origin, no path or trailing slash (e.g. https://algoflow.io)
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection URI)
MONGODB_URI=mongodb://127.0.0.1:27017/algoflow

# Authentication secrets. Required in every mode except test (there is no built-in fallback), and never a value that
# has been published in this repository. Fill both in your .env with:  npm run env:secrets
# (writes random values without printing them). In staging/production use at least 32 random characters, different
# for each secret, from your secret store.
JWT_SECRET=
COOKIE_SECRET=

# Reverse Proxy Configuration (set to 1, true, or hop count if behind Nginx/ALB/Cloudflare)
TRUST_PROXY=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_API=100

# Development only: also seed the fixed-password ADMIN and SUPER_ADMIN demo accounts (never seeded in other modes).
# The first real administrator is created with `npm run admin:bootstrap` (see server/scripts/bootstrapAdmin.ts).
SEED_DEV_ADMINS=false

# Code execution for the Playground. disabled (default) | judge0 | fake | local. 'fake' does not run code: automated
# tests only, and it is refused in staging/production. Nothing is executed (or billed) until this is set to judge0 or local.
# 'local' (development only, refused in staging/production) runs Python on this machine, one limited process per run
# (time, memory, output; no file writes, network or subprocesses). It is NOT a sandbox for untrusted users' code; see
# server/services/execution/localPythonProvider.ts. C, C++ and Java are not available with it. The server then refuses to
# start unless it listens on loopback only (HOST unset in development, or HOST=127.0.0.1 / ::1; test mode needs HOST set).
EXECUTION_PROVIDER=disabled
# EXECUTION_PROVIDER=local: the Python 3.8+ interpreter (a command on PATH or a full path); default "python"
# LOCAL_PYTHON_PATH=
# Judge0: hosted through RapidAPI, e.g. https://judge0-ce.p.rapidapi.com with JUDGE0_AUTH=rapidapi, or a self-hosted
# instance (JUDGE0_AUTH=x-auth-token or none). The key stays on the server; never put it in a VITE_ variable.
# JUDGE0_API_URL=
# JUDGE0_API_KEY=
# JUDGE0_AUTH=rapidapi
# Optional language id / label overrides (JSON), when the instance's ids differ from Judge0 CE's.
# JUDGE0_LANGUAGES=
# Abuse and cost limits. Keep the global daily limit below your plan's daily allowance to avoid paid overage.
EXECUTION_RATE_LIMIT_PER_MINUTE=10
EXECUTION_DAILY_LIMIT_PER_USER=100
EXECUTION_DAILY_LIMIT_GLOBAL=1800

# AI Tutor. disabled (default) | gemini | fake. A GEMINI_API_KEY alone never enables it: set AI_PROVIDER=gemini too.
# 'fake' does not answer questions: automated tests only, refused in staging/production.
AI_PROVIDER=disabled
# Google Gemini (server-side only; never put it in a VITE_ variable). The key is sent in the x-goog-api-key header.
# GEMINI_API_KEY=
# A model id with free-tier access on your project, checked in Google AI Studio (no default), e.g. gemini-3.5-flash-lite.
# Google limits the 2.5 models to projects that used them before (others get HTTP 404). gemini-3.5-flash-lite thinks at
# a minimal level by default; its thinking tokens count against each answer's 1024-token output limit.
# GEMINI_MODEL=
# Limits. Keep the global limits below your project's free per-minute and daily request limits (shown in AI Studio);
# Google's limits apply to the whole Google Cloud project, so environments that share a key share them too.
# Per-minute limits and "one question at a time" are kept in each server process's memory (not shared between
# instances). Daily limits are stored in MongoDB (shared by instances using the same database) and reset at midnight
# Pacific Time, when Google's daily limits reset.
TUTOR_RATE_LIMIT_PER_MINUTE=10
TUTOR_GLOBAL_RATE_LIMIT_PER_MINUTE=5
TUTOR_DAILY_LIMIT_PER_USER=30
TUTOR_DAILY_LIMIT_GLOBAL=200
