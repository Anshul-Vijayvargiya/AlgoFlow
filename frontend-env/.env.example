# Front-end build variables. Vite reads env files from this folder only (see vite.config.ts), never the server's
# root .env. Copy to frontend-env/.env.production.local for local production builds; *.local and .env files are
# git-ignored. Everything here is compiled into the public bundle: never put a secret in a VITE_ variable.

# Required for every deployable `vite build` (the build fails without it):
#   /api                          front end and API behind one origin (reverse proxy routes /api to the server)
#   https://api.example.com/api   API on its own host; it must be same-site with the front end (auth cookie is
#                                 SameSite=Lax) and the server's CLIENT_URL must be the front end's exact origin
VITE_API_BASE_URL=/api

# Never set VITE_USE_MOCK_API=true here: deployable builds fail with it; only `--mode e2e` (Playwright) allows it.
